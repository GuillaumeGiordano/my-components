{
	"name": "@guillaumeg/ui",
	"version": "0.4.2",
	"description": "Bibliothèque de composants Svelte 5 — UI, formulaires, layout, sections.",
	"keywords": ["svelte", "svelte5", "components", "ui", "forms", "layout", "design-system"],
	"author": "guillaumeG",
	"license": "MIT",
	"private": false,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"generate:themes": "node scripts/generate-themes.ts",
		"package": "node scripts/generate-themes.ts && svelte-kit sync && svelte-package -i src/lib -o package",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"svelte": "./package/index.js",
	"types": "./package/index.d.ts",
	"main": "./package/index.js",
	"exports": {
		".": {
			"types": "./package/index.d.ts",
			"svelte": "./package/index.js",
			"default": "./package/index.js"
		},
		"./styles/tokens.css": "./package/styles/tokens.css",
		"./themes/*.css": "./package/styles/themes/*.css"
	},
	"files": [
		"package"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@lucide/svelte": "^1.3.0"
	}
}
